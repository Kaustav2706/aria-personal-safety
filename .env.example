# ── Backend ──────────────────────────────────────────────────────────────────
# REQUIRED: Set to "production" on Render/Railway/any cloud host.
# Without this the server will NOT crash on DB failure — see backend/src/config/db.js.
NODE_ENV="production"

# REQUIRED: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional: port the HTTP server listens on (default 5000)
PORT=5000

# JWT signing secret — use a long random string, never reuse across environments
JWT_SECRET="your-strong-random-jwt-secret"

# Evidence vault encryption key — MUST be independent of JWT_SECRET.
# If not set, the service falls back to a JWT_SECRET-derived key (backward-compatible
# but insecure: rotating JWT_SECRET would make all stored vault files unreadable).
# Generate with: openssl rand -hex 32
EVIDENCE_KEY="your-strong-independent-evidence-encryption-key"

# Shared secret between backend and AI engine (prevents public access to /analyze)
AI_ENGINE_SECRET="your-strong-ai-engine-secret"

# Police dispatcher accounts are provisioned via the standard registration endpoint
# with role='police'. There is no shared API key — dispatchers log in individually
# through the /login page of the police dashboard and receive a short-lived JWT.
# To seed a dispatcher account, run: npm run seed:police (see backend/src/scripts/)

# Public URL of the backend (used by AI engine CORS and PDF report links)
BACKEND_URL="https://your-backend-domain.com"

# Allowed CORS origins for API, WebSocket live feed, and AI Engine (comma-separated frontends)
ALLOWED_ORIGINS="https://app.yourdomain.com,https://police.yourdomain.com"

# ── Twilio (SMS & Voice alerts) ───────────────────────────────────────────────
TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ── Alert Escalation Thresholds ───────────────────────────────────────────────
# Tiered response thresholds (0-100) preventing alarm fatigue and false alarms:
# - ALERT_SMS_THRESHOLD: Moderate score triggering SMS to contacts (default: 50)
# - ALERT_VOICE_CALL_THRESHOLD: High score triggering voice calls (default: 75)
# - ALERT_POLICE_THRESHOLD: Critical score broadcasting to police dispatch (default: 85)
# - DEV_TEST_EMERGENCY_PHONE: Optional test recipient for local development ONLY (NODE_ENV !== 'production'). In production, alerts strictly reach the user's verified emergency contacts.
ALERT_SMS_THRESHOLD=50
ALERT_VOICE_CALL_THRESHOLD=75
ALERT_POLICE_THRESHOLD=85
DEV_TEST_EMERGENCY_PHONE=""

# ── Firebase (push notifications to police dashboard) ────────────────────────
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# Base64-encode your service account private key:
# base64 -w0 path/to/serviceAccountKey.json | pbcopy
FIREBASE_PRIVATE_KEY_BASE64="base64-encoded-private-key"

# ── AI Engine ─────────────────────────────────────────────────────────────────
# (AI_ENGINE_SECRET is shared with backend above)
# URL where the AI engine is reachable from the backend
AI_ENGINE_URL="http://localhost:8000"

# Maximum number of AI analysis requests that may queue simultaneously (default 10).
# Requests beyond this cap are dropped immediately rather than stacking forever.
AI_MAX_QUEUE_SIZE=10

# Maximum concurrent AI requests forwarded to the Python engine (default 3).
AI_CONCURRENCY_LIMIT=3

# Silence threshold for the Whisper detector (default 0.002 ≈ -54 dBFS).
# Clips whose RMS amplitude normalised to [0,1] is below this value are skipped
# without entering Whisper, freeing the transcription lock for real speech.
WHISPER_SILENCE_RMS_THRESHOLD=0.002
