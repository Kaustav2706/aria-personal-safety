# ── Backend ──────────────────────────────────────────────────────────────────
# REQUIRED: Set to "production" on Render/Railway/any cloud host.
# Without this the server will NOT crash on DB failure — see backend/src/config/db.js.
NODE_ENV="production"

# REQUIRED: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional: port the HTTP server listens on (default 5000)
PORT=5000

# JWT signing secret — use a long random string, never reuse across environments
JWT_SECRET="your-strong-random-jwt-secret"

# Shared secret between backend and AI engine (prevents public access to /analyze)
AI_ENGINE_SECRET="your-strong-ai-engine-secret"

# Police dispatcher accounts are provisioned via the standard registration endpoint
# with role='police'. There is no shared API key — dispatchers log in individually
# through the /login page of the police dashboard and receive a short-lived JWT.
# To seed a dispatcher account, run: npm run seed:police (see backend/src/scripts/)

# Public URL of the backend (used by AI engine CORS and PDF report links)
BACKEND_URL="https://your-backend-domain.com"

# ── Twilio (SMS & Voice alerts) ───────────────────────────────────────────────
TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ── Firebase (push notifications to police dashboard) ────────────────────────
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# Base64-encode your service account private key:
# base64 -w0 path/to/serviceAccountKey.json | pbcopy
FIREBASE_PRIVATE_KEY_BASE64="base64-encoded-private-key"

# ── AI Engine ─────────────────────────────────────────────────────────────────
# (AI_ENGINE_SECRET is shared with backend above)
# URL where the AI engine is reachable from the backend
AI_ENGINE_URL="http://localhost:8000"
